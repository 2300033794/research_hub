# MongoDB Atlas connection string
MONGODB_URI=

# Auth.js (NextAuth) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Google Cloud OAuth 2.0 Web client
# Authorized JavaScript origin: http://localhost:3000
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (server-side only — never expose the API secret)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed script admin (do not use these values in production)
ADMIN_EMAIL=admin@researchhub.local
ADMIN_PASSWORD=
